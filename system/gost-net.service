[Unit]
Description=GOST: ensure Wi-Fi radio is enabled at every boot
# NetworkManager can come up with the Wi-Fi radio soft-disabled (nmcli radio
# wifi = off); nothing re-enables it until a manual join, so WiFi looks dead
# on boot (bailey 2026-07-14). Force it on before the kiosk needs the network.
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=-/usr/sbin/rfkill unblock wifi
# Regulatory domain: with no country the kernel defaults to "00" (world),
# which disables most channels -- the radio then can't scan or join and WiFi
# looks dead (bailey: "wifi still having issues" 2026-07-24). Set it from
# /etc/gost-wifi-country (default US) BEFORE bringing the radio up.
ExecStart=-/bin/sh -c 'iw reg set "$(cat /etc/gost-wifi-country 2>/dev/null || echo US)"'
ExecStart=-/usr/bin/nmcli radio wifi on
ExecStart=-/usr/bin/nmcli networking on
# Disable Wi-Fi power-save: the Pi's radio sleeps when idle and drops the
# connection mid-session (bailey saw repeated drops 2026-07-14). -w is
# best-effort; the NetworkManager conf.d drop-in makes it stick per-connection.
ExecStart=-/usr/sbin/iw dev wlan0 set power_save off

[Install]
WantedBy=multi-user.target
