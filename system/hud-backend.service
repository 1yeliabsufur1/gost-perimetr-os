[Unit]
Description=GOST/PERIMETR OS backend (telemetry, TV/guide engine, kiosk control)
After=network.target
Wants=network.target
# Appliance rule: never rate-limit into a permanent 'failed' state -- keep
# retrying forever (default is give-up after 5 starts in 10s).
StartLimitIntervalSec=0

[Service]
Type=simple
User=__GOST_USER__
Group=__GOST_USER__
SupplementaryGroups=dialout gpio spi i2c video render
WorkingDirectory=/opt/gost
Environment=GOST_APP=/opt/gost/app
Environment=GOST_MEDIA=/opt/gost/media
Environment=GOST_MAPS=/opt/gost/maps
Environment=GOST_STATE=/opt/gost/state
ExecStart=/opt/gost/venv/bin/python3 -u /opt/gost/backend/hud_server.py
Restart=always
# 5s pacing so a crash can't tight-loop; combined with StartLimitIntervalSec=0
# it retries forever but never hammers. The backend also logs a full
# traceback on any fatal exception before exiting, so the journal shows why.
RestartSec=5
# Bound shutdown: a blocking serial read in an executor thread can keep the
# process from exiting on SIGTERM, hanging `systemctl stop/restart` for the
# default 90s (seen 2026-07-14). Force-kill the whole cgroup after 5s. State
# is written on change, not exit, so a hard kill loses nothing.
TimeoutStopSec=5
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
