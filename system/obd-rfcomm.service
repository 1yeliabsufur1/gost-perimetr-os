[Unit]
Description=OBDLink MX+ SPP link (provides /dev/rfcomm0 for GOST OBD)
After=bluetooth.service
Wants=bluetooth.service
# retry forever through long engine-off periods; do not trip the start limiter
# (a parked truck must not permanently kill the link until reboot)
StartLimitIntervalSec=0

[Service]
Type=simple
# '-' so a missing config file (not paired yet) doesn't block start; the
# link script self-provisions and backs off.
EnvironmentFile=-/etc/gost/obd-bt.conf
ExecStartPre=-/usr/sbin/rfkill unblock bluetooth
ExecStart=/usr/local/bin/obd-rfcomm-link.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
