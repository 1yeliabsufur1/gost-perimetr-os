# Installed to /etc/sudoers.d/gost by install.sh (validated with `visudo -c`
# before being put in place). Lets the operator user set their own system
# password and system clock from the kiosk UI without a sudo password
# prompt, restricted to these exact helper scripts.
__GOST_USER__ ALL=(root) NOPASSWD: /usr/local/sbin/gost-setpass
__GOST_USER__ ALL=(root) NOPASSWD: /usr/local/sbin/gost-settime
__GOST_USER__ ALL=(root) NOPASSWD: /usr/local/sbin/gost-power
# Wi-Fi from the kiosk UI: NetworkManager's polkit denies the service user
# ("Not authorized to control networking" -- seen on hardware 2026-07-12), so
# the backend falls back to sudo for exactly these network commands.
__GOST_USER__ ALL=(root) NOPASSWD: /usr/bin/nmcli, /usr/sbin/rfkill
