[Unit]
Description=GOST/PERIMETR OS first-boot self-installer (runs once, then disables itself)
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/opt/gost/.installed
# Kill the tty1 login prompt during install -- getty was painting
# "raspberrypi login:" straight over our progress banner, which reads as
# "the OS is broken" (bailey's photos 2026-07-12). The kiosk unit has its
# own Conflicts=getty@tty1 for every boot after this one.
Conflicts=getty@tty1.service

[Service]
Type=oneshot
# Clear tty1 and paint ONE clean full-screen banner (no scrolling log spam --
# bailey: the install log on the console reads as "starting in the terminal").
ExecStartPre=/bin/sh -c 'printf "\033c\n\n    GOST / PERIMETR OS\n    ==================\n\n    First-boot setup in progress -- this takes a few minutes\n    and reboots into the dashboard automatically.\n\n    Do NOT power off.\n" > /dev/tty1 || true'
ExecStart=/opt/gost-src/install.sh
# "infinity", not "0": trixie's systemd start-timed-out a ~4.5-minute
# install with the 0 spelling (observed on real hardware 2026-07-04).
TimeoutStartSec=infinity
# Log to the JOURNAL only (not the console) so the clean banner above stays
# on screen instead of scrolling install text.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
