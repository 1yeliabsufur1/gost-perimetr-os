[Unit]
Description=GOST/PERIMETR OS first-boot self-installer (runs once, then disables itself)
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/opt/gost/.installed
# Kill the tty1 login prompt during install -- getty was painting
# "raspberrypi login:" straight over our progress banner, which reads as
# "the OS is broken" (bailey's photos 2026-07-12). The kiosk unit has its
# own Conflicts=getty@tty1 for every boot after this one.
Conflicts=getty@tty1.service

[Service]
Type=oneshot
ExecStartPre=/bin/sh -c 'echo "\n*** GOST/PERIMETR OS FIRST-BOOT INSTALL ***\n*** Takes ~10 minutes with internet connected -- reboots into the dashboard when done. ***\n*** Do NOT power off. Default login if you need a shell: gost / gost ***\n" > /dev/tty1 || true'
ExecStart=/opt/gost-src/install.sh
# "infinity", not "0": trixie's systemd start-timed-out a ~4.5-minute
# install with the 0 spelling (observed on real hardware 2026-07-04).
TimeoutStartSec=infinity
# journal+console so install progress is visible on the attached screen
# instead of leaving the operator staring at a bare login prompt.
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
