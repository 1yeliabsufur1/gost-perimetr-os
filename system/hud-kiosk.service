[Unit]
Description=GOST/PERIMETR OS kiosk (cage + chromium)
After=hud-backend.service seatd.service getty@tty1.service systemd-user-sessions.service
Wants=hud-backend.service seatd.service
Conflicts=getty@tty1.service
# SAFE MODE: if either safe-mode marker exists the kiosk is SKIPPED entirely,
# so getty@tty1 is never conflicted-out and you boot straight to a console.
#   From the Pi:        touch /boot/gost_safe_mode && sudo reboot
#   From a PC (SD card): create an empty file 'gost_safe_mode' on the bootfs
#                        partition (that mounts at /boot/firmware).
ConditionPathExists=!/boot/gost_safe_mode
ConditionPathExists=!/boot/firmware/gost_safe_mode
StartLimitIntervalSec=0

[Service]
Type=simple
User=__GOST_USER__
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
ExecStart=/opt/gost/system/kiosk-start.sh
Restart=always
RestartSec=3
# kiosk-start.sh exits 42 when its own crash-loop breaker trips; that must NOT
# be restarted -- it means "give up and leave tty2-6 consoles usable".
RestartPreventExitStatus=42

[Install]
# CRITICAL: multi-user.target, NOT graphical.target. Pi OS Lite boots to
# multi-user.target and never reaches graphical.target (no display manager),
# so a graphical.target-wanted unit would silently never start -- which is
# exactly why the kiosk never took the screen and the operator saw a login
# prompt instead. multi-user.target is reached on every single boot.
WantedBy=multi-user.target
